APP_NAME=FoodLink
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=foodlink
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Module 3.3 Food Request Management (NG JIA QIN)
# local = read donations straight from the database (default)
# http  = consume the Food Donation Management REST web service instead
FOODLINK_DONATION_GATEWAY=local
FOODLINK_API_BASE_URL=http://localhost:8000
FOODLINK_API_TIMEOUT=5
